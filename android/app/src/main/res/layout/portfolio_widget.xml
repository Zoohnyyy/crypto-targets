<?xml version="1.0" encoding="utf-8"?>
<!--
  4x1 portfolio widget: a single row with the total value, its 24h change, and
  the last update time. Holding rows deliberately omitted — at one cell tall
  there is only room for the headline figure.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/portfolio_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Total value + 24h change (or the empty hint, when no holdings yet) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/pf_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/pf_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingBottom="2dp"
            android:textColor="#16C784"
            android:textStyle="bold"
            android:maxLines="1"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pf_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/portfolio_widget_empty"
            android:textColor="#9AA0A6"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/pf_updated_at"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:text="@string/widget_tap_to_open"
        android:textColor="#9AA0A6"
        android:maxLines="1"
        android:textSize="10sp" />

</LinearLayout>
