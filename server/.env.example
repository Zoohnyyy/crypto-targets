# Copy to .env for local dev, or set these as environment variables on Railway.

# Port the HTTP server listens on (Railway sets PORT automatically).
PORT=8080

# Shared secret. Generate a random string and put the SAME value in the app's
# --dart-define=PUSH_API_KEY=... build flag.
API_KEY=change-me-to-a-long-random-string

# Firebase service account JSON, as ONE line. From Firebase Console →
# Project settings → Service accounts → Generate new private key, then paste the
# whole file content here (minified to a single line).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Comma-separated base symbols served from Bybit instead of Binance.
BYBIT_SYMBOLS=hype

# Where to persist device registrations (a mounted volume path on Railway).
DATA_FILE=./data/devices.json
